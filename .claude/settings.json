{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "NO `model` KEY, ON PURPOSE (24/09/2026 — repodocs ADR-026). A pin written here cannot win: the account's server-managed settings outrank every local file. And `opus[1m]` was a version pin wearing a window suffix — the 1M variant existed only for the previous Opus, so every session was born on it while the catalog already offered the newer one. To pin a model again, NAME the version: \"model\": \"opus55\". The highest effortLevel a FILE accepts is 'xhigh'; use /effort max for a single session.",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "_comment": "Permissoes do projeto - Python (srv.py)",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)"
    ]
  }
}
